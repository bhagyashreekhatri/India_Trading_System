# ─────────────────────────────────────────────────────────────────────────────
# Server SSH Config — copy this to deploy/server_config.env and fill in values
# deploy/server_config.env is in .gitignore — NEVER commit it
# ─────────────────────────────────────────────────────────────────────────────

# Your DigitalOcean droplet IP address
SERVER_IP=your.droplet.ip.here

# Linux user on the server (created by setup_server.sh)
SERVER_USER=trading

# Path to .env on the server
SERVER_ENV_PATH=/opt/trading/.env

# Path to your SSH private key (leave blank to use default ~/.ssh/id_rsa)
SSH_KEY_PATH=~/.ssh/id_rsa
