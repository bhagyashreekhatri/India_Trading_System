# ─────────────────────────────────────────────────────────────────────────────
# NSE Trading System — Environment Variables Template
# Copy this to .env and fill in your real values
# NEVER commit .env to git — only this .env.example file is safe to push
# ─────────────────────────────────────────────────────────────────────────────

# Zerodha Kite API (from https://developers.kite.trade/)
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# Kite Access Token — refreshed every morning via kite_login.py
# On the server this is updated automatically by the morning login script
KITE_ACCESS_TOKEN=generated_each_morning

# Groq LLM API (from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# NewsAPI (from https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here

# ChromaDB vector store path (relative to project root)
CHROMA_PERSIST_DIR=./chroma_store
